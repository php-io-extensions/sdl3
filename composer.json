{
    "name": "php-io-extensions/sdl3",
    "type": "php-ext",
    "description": "1:1 PHP bindings of SDL 3: windows, surfaces, the GL, Metal and Vulkan hooks, and SDL_GPU",
    "keywords": [
        "sdl3",
        "sdl",
        "gpu",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "depends": [
                        "libx11-6",
                        "libxext6",
                        "libxkbcommon0",
                        "libwayland-client0",
                        "libwayland-cursor0",
                        "libwayland-egl1",
                        "libdecor-0-0"
                    ],
                    "recommends": [
                        "libasound2t64",
                        "libpulse0",
                        "libpipewire-0.3-0t64"
                    ]
                },
                "brew": {
                    "build": [
                        "sdl3"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "sdl3",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-sdl3",
                "description": "Enable the sdl3 extension",
                "needs-value": false
            }
        ]
    }
}
